+/* The ACL link is encrypted, but HCI_Read_Encryption_Key_Size has not
+ * completed yet, so enc_key_size is still 0. A connect request that
+ * arrives in this window must wait for the key size (hci_encrypt_cfm ->
+ * l2cap_security_cfm answers it), not be refused with a security block.
+ */
+static bool l2cap_enc_key_size_pending(struct hci_conn *hcon)
+{
+	return hcon->type == ACL_LINK &&
+	       test_bit(HCI_CONN_ENCRYPT, &hcon->flags) &&
+	       !hcon->enc_key_size;
+}
