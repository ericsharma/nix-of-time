+# Non-blocking macro control for scripted clients (ace-typer). Timing runs
+# inside the controller process; 'macro' below blocks the server instead.
+@sio.on('macro_async')
+def handle_macro_async(message):
+    index, macro = json.loads(message)
+    return nxbt.macro(int(index), macro, block=False)
+
+
+@sio.on('macro_done')
+def handle_macro_done(message):
+    index, macro_id = json.loads(message)
+    return macro_id in nxbt.state[int(index)]["finished_macros"]
+
+
+@sio.on('macro_clear')
+def handle_macro_clear(index):
+    nxbt.clear_macros(int(index))
+    return True
+
+
+# ACE box codes (ace-typer): preview a pasted code, then type it as one
+# non-blocking macro on the caller's controller.
+try:
+    from ace_typer import web as ace_web
+except ImportError:  # ace-typer not installed
+    ace_web = None
+
+
+@sio.on('ace_preview')
+def handle_ace_preview(message):
+    if ace_web is None:
+        return {"ok": False, "error": "ace-typer is not installed"}
+    data = json.loads(message)
+    return ace_web.preview(data["text"], switch=data.get("switch", True))
+
+
+@sio.on('ace_type')
+def handle_ace_type(message):
+    if ace_web is None:
+        return {"ok": False, "error": "ace-typer is not installed"}
+    data = json.loads(message)
+    result = ace_web.compile(
+        data["text"], code=int(data.get("code", 1)), first=data.get("first"),
+        switch=data.get("switch", True), params=data.get("params"))
+    if not result["ok"]:
+        return result
+    index = int(data["index"])
+    nxbt.clear_macros(index)
+    result["macro_id"] = nxbt.macro(index, result.pop("macro"), block=False)
+    return result
+
+
 @sio.on('macro')
 def handle_macro(message):
     message = json.loads(message)
