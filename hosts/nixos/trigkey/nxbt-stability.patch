+++ b/nxbt/web/static/js/ace.js
@@ -0,0 +1,182 @@
+/* ACE box codes panel: paste a code (CodeGenerator output, character or
+ * Hex Writer codes), preview what will be typed, then type it as one nxbt
+ * macro on this page's controller. Uses `socket` and NXBT_CONTROLLER_INDEX
+ * from main.js. */
+
+const ACE = {
+    preview: null,      // last preview result
+    running: null,      // {macroId, seconds, started, timer}
+};
+
+function aceEl(id) { return document.getElementById(id); }
+
+function aceShow(text) {
+    // Make spaces visible in names.
+    return text.replaceAll(" ", "␣");
+}
+
+function aceEscape(text) {
+    const div = document.createElement("div");
+    div.textContent = text;
+    return div.innerHTML;
+}
+
+function aceSetStatus(text, kind) {
+    const el = aceEl("ace-status");
+    el.textContent = text;
+    el.className = "ace-status" + (kind ? " ace-" + kind : "");
+}
+
+function acePreview() {
+    const text = aceEl("ace-text").value;
+    if (!text.trim()) {
+        aceSetStatus("Paste a code first.", "error");
+        return;
+    }
+    socket.emit("ace_preview", JSON.stringify({
+        text: text, switch: aceEl("ace-switch").checked,
+    }), aceRenderPreview);
+}
+
+function aceRenderPreview(result) {
+    ACE.preview = result;
+    const out = aceEl("ace-preview");
+    out.innerHTML = "";
+    aceEl("ace-type").disabled = true;
+    if (!result.ok) {
+        aceSetStatus(result.error, "error");
+        return;
+    }
+    const codeSelect = aceEl("ace-code");
+    codeSelect.innerHTML = "";
+    result.codes.forEach((c, i) => {
+        const opt = document.createElement("option");
+        opt.value = i + 1;
+        opt.textContent = `${c.title} (${c.kind === "hex" ? "Hex Writer" : "characters"})`;
+        codeSelect.appendChild(opt);
+    });
+    aceEl("ace-code-row").classList.toggle("hidden", result.codes.length < 2);
+    aceRenderCode();
+}
+
+function aceRenderCode() {
+    const code = ACE.preview.codes[parseInt(aceEl("ace-code").value) - 1];
+    const out = aceEl("ace-preview");
+    let html = "";
+    if (code.raw_verified) {
+        html += `<p class="ace-ok">All box names match the Raw data byte for byte.</p>`;
+    }
+    code.warnings.forEach(w => { html += `<p class="ace-warning">${aceEscape(w)}</p>`; });
+    html += `<table class="ace-table mono"><tr><th>Box</th><th>Name</th><th>Notes</th></tr>`;
+    code.boxes.forEach(b => {
+        let name = "";
+        if (b.action === "type") name = `<span class="ace-name">${aceEscape(aceShow(b.name))}</span>`;
+        else if (b.action === "leave") name = "<em>leave as is</em>";
+        else if (b.action === "unchanged") name = "<em>not in code</em>";
+        else if (b.action === "fill") {
+            name = `${aceEscape(b.template)} `;
+            const runs = b.template.match(/[*&%$]+/g) || [];
+            runs.forEach(run => {
+                name += `<input class="ace-param mono" data-box="${b.box}" data-run="${aceEscape(run)}"` +
+                        ` maxlength="${run.length}" size="${run.length}" placeholder="${aceEscape(run)}"` +
+                        ` onfocus="disableKeyHandlers()" onblur="enableKeyHandlers()">`;
+            });
+        }
+        let notes = b.warnings.map(aceEscape).join("<br>");
+        if (b.note) notes += (notes ? "<br>" : "") + aceEscape(b.note);
+        html += `<tr><td>${b.box}</td><td>${name}</td><td>${notes}</td></tr>`;
+    });
+    html += "</table>";
+    out.innerHTML = html;
+
+    const first = aceEl("ace-first");
+    first.innerHTML = "";
+    code.boxes.filter(b => b.action === "type" || b.action === "fill").forEach(b => {
+        const opt = document.createElement("option");
+        opt.value = b.box;
+        opt.textContent = `Box ${b.box}`;
+        first.appendChild(opt);
+    });
+    aceUpdateStartHint();
+    aceEl("ace-type").disabled = false;
+    aceSetStatus(`Ready. ${code.boxes.filter(b => b.action === "type").length} boxes to type.`, "ok");
+}
+
+function aceUpdateStartHint() {
+    const first = aceEl("ace-first").value;
+    aceEl("ace-start-hint").textContent =
+        `Before typing: PC → MOVE POKéMON, cursor on the title of Box ${first}, hand empty.`;
+}
+
+function aceParams() {
+    const params = {};
+    document.querySelectorAll(".ace-param").forEach(input => {
+        const box = input.dataset.box;
+        params[box] = params[box] || {};
+        params[box][input.dataset.run] = input.value.trim();
+    });
+    return params;
+}
+
+function aceType() {
+    if (NXBT_CONTROLLER_INDEX === false) {
+        aceSetStatus("No controller on this page. Create a controller first.", "error");
+        return;
+    }
+    if (ACE.running) return;
+    aceEl("ace-type").disabled = true;
+    socket.emit("ace_type", JSON.stringify({
+        index: NXBT_CONTROLLER_INDEX,
+        text: aceEl("ace-text").value,
+        code: parseInt(aceEl("ace-code").value),
+        first: parseInt(aceEl("ace-first").value),
+        switch: aceEl("ace-switch").checked,
+        params: aceParams(),
+    }), result => {
+        if (!result.ok) {
+            aceEl("ace-type").disabled = false;
+            aceSetStatus(result.error, "error");
+            return;
+        }
+        ACE.running = {
+            macroId: result.macro_id, seconds: result.seconds,
+            started: Date.now(), end: result.end_box,
+        };
+        aceEl("ace-stop").disabled = false;
+        aceEl("ace-progress").classList.remove("hidden");
+        ACE.running.timer = setInterval(acePoll, 1000);
+        aceSetStatus(`Typing Boxes ${result.start_box}–${result.end_box} ` +
+                     `(${result.presses} presses). Don't use the keyboard on this page.`, "running");
+    });
+}
+
+function aceFormat(seconds) {
+    const s = Math.max(0, Math.round(seconds));
+    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
+}
+
+function acePoll() {
+    const run = ACE.running;
+    if (!run) return;
+    const elapsed = (Date.now() - run.started) / 1000;
+    aceEl("ace-progress-bar").style.width = Math.min(100, 100 * elapsed / run.seconds) + "%";
+    aceEl("ace-progress-text").textContent = `${aceFormat(elapsed)} / ${aceFormat(run.seconds)}`;
+    socket.emit("macro_done", JSON.stringify([NXBT_CONTROLLER_INDEX, run.macroId]), done => {
+        if (done && ACE.running === run) aceFinish(`Done. Check every name, then trigger ACE. Ends on Box ${run.end}.`, "ok");
+    });
+}
+
+function aceFinish(message, kind) {
+    if (ACE.running) clearInterval(ACE.running.timer);
+    ACE.running = null;
+    aceEl("ace-stop").disabled = true;
+    aceEl("ace-type").disabled = false;
+    aceEl("ace-progress").classList.add("hidden");
+    aceSetStatus(message, kind);
+}
+
+function aceStop() {
+    socket.emit("macro_clear", NXBT_CONTROLLER_INDEX, () => {
+        aceFinish("Stopped. All buttons released.", "error");
+    });
+}
