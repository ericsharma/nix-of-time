+def system_bus():
+    """A private system-bus connection for the calling process.
+
+    nxbt forks after creating BlueZ objects; a shared connection used from
+    both sides of a fork gets closed by dbus-daemon ("Connection is closed").
+    """
+    pid = os.getpid()
+    bus = _BUSES.get(pid)
+    if bus is None or not bus.get_is_connected():
+        bus = dbus.SystemBus(private=True)
+        _BUSES.clear()
+        _BUSES[pid] = bus
+    return bus
+
