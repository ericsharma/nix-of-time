{
  "uid": "portless-services",
  "title": "Portless Services",
  "description": "Every <alias>.local name published on the LAN, across both hosts, and whether it answers right now. Probed by blackbox_exporter through each host's portless proxy, so a row goes red both when the service behind the name is down and when the proxy has lost the route. Names are declared in inventory.nix; the probe list is generated from it (hosts/nixos/optional/monitoring.nix).",
  "tags": ["portless", "lan", "services"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "query": "label_values(probe_success{job=\"portless\"}, instance)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Names up",
      "description": "How many published .local names answer, out of the total declared.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(probe_success{job=\"portless\", instance=~\"$host\"})",
          "instant": true,
          "legendFormat": "up"
        },
        {
          "refId": "B",
          "expr": "count(probe_success{job=\"portless\", instance=~\"$host\"})",
          "instant": true,
          "legendFormat": "total"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Names down",
      "description": "Anything above zero means a .local URL on the LAN is currently broken.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "count(probe_success{job=\"portless\", instance=~\"$host\"} == 0) or vector(0)",
          "instant": true,
          "legendFormat": "down"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Slowest response",
      "description": "The longest probe round-trip among the names that answered. A jump here usually lands before an outright failure does.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 14, "x": 10, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "max(probe_duration_seconds{job=\"portless\", instance=~\"$host\"} and probe_success{job=\"portless\", instance=~\"$host\"} == 1)",
          "instant": true,
          "legendFormat": "slowest"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Current status",
      "description": "One row per published name. Status is the live probe result; HTTP code tells you which kind of failure it is — 502 means portless is up but the service behind it is not, 404 means the daemon has lost the route.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"portless\", instance=~\"$host\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "probe_http_status_code{job=\"portless\", instance=~\"$host\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "probe_duration_seconds{job=\"portless\", instance=~\"$host\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "alias", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "instance 2": true,
              "instance 3": true,
              "service 2": true,
              "service 3": true,
              "backend_port 2": true,
              "backend_port 3": true
            },
            "renameByName": {
              "alias": "Name",
              "instance 1": "Host",
              "service 1": "Service",
              "backend_port 1": "Port",
              "Value #A": "Status",
              "Value #B": "HTTP",
              "Value #C": "Response"
            },
            "indexByName": {
              "alias": 0,
              "instance 1": 1,
              "backend_port 1": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [{ "displayName": "Status", "desc": false }],
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left", "cellOptions": { "type": "auto" }, "filterable": false },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "custom.width", "value": 110 },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "DOWN", "color": "red", "index": 0 },
                      "1": { "text": "UP", "color": "green", "index": 1 }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "HTTP" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 90 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Response" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 3 },
              { "id": "custom.width", "value": 120 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Name" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open ${__value.raw}",
                    "url": "http://${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Port" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 80 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Host" },
            "properties": [{ "id": "custom.width", "value": 120 }]
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "Availability history",
      "description": "Every gap is a window where the .local name did not answer. The finance rows are expected to be red whenever the dev server is not running — the alias is static, the server is started by hand.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"portless\", instance=~\"$host\"}",
          "legendFormat": "{{alias}}"
        }
      ],
      "options": {
        "showValue": "never",
        "rowHeight": 0.9,
        "mergeValues": true,
        "alignValue": "center",
        "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 0, "fillOpacity": 80 },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "down", "color": "red", "index": 0 },
                "1": { "text": "up", "color": "green", "index": 1 }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Probe response time",
      "description": "Round-trip through the portless proxy to the service and back. Only successful probes are plotted, so a line stopping means the name went down.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=\"portless\", instance=~\"$host\"} and probe_success{job=\"portless\", instance=~\"$host\"} == 1",
          "legendFormat": "{{alias}}"
        }
      ],
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      }
    }
  ]
}
