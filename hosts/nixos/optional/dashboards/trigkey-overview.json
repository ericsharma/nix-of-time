      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "100 - (node_filesystem_avail_bytes{mountpoint=~\"/mnt/immich-data.*|/var/lib/garage.*\"} / node_filesystem_size_bytes{mountpoint=~\"/mnt/immich-data.*|/var/lib/garage.*\"} * 100)",
          "legendFormat": "{{mountpoint}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Storage Utilization (Immich + Garage)",
      "type": "gauge"
    },
