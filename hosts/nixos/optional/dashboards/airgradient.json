    {
      "type": "stat",
      "title": "Air quality history retained",
      "description": "Measured on the 100y AirGradient store (port 9091), read through the 90d main Prometheus, which scrapes it. Retained must rise by one day per day; dropped must stay 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - prometheus_tsdb_lowest_timestamp_seconds{job=\"prometheus-airgradient\"}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 2592000
              },
              {
                "color": "green",
                "value": 15552000
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Air quality blocks dropped by retention",
      "description": "Measured on the 100y AirGradient store (port 9091), read through the 90d main Prometheus, which scrapes it. Retained must rise by one day per day; dropped must stay 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
